      "html": "<button class=\"ds-primary\">começar agora →</button>",
      "css": ".ds-primary{min-height:48px;padding:0 20px;border-radius:99px;border:1px solid var(--accent,#0E6B55);font:600 16px Inter,system-ui,sans-serif;cursor:pointer;background:var(--accent,#0E6B55);color:var(--accent-ink,#fff)} :focus-visible{outline:3px solid var(--accent,#0E6B55);outline-offset:2px}",
      "refersTo": "button-primary"
    },
    {
      "name": "Ação secundária",
      "kind": "button",
      "description": "Ação secundária conforme CSS oficial.",
      "html": "<button class=\"ds-secondary\">voltar à trilha</button>",
      "css": ".ds-secondary{min-height:48px;padding:0 20px;border-radius:99px;border:1px solid var(--accent,#0E6B55);font:600 16px Inter,system-ui,sans-serif;cursor:pointer;background:var(--panel,#fff);color:var(--accent,#0E6B55)} :focus-visible{outline:3px solid var(--accent,#0E6B55);outline-offset:2px}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Reflexão",
      "kind": "input",
      "description": "Reflexão conforme CSS oficial.",
      "html": "<label for=\"ds-note\">Minha reflexão</label><textarea id=\"ds-note\" class=\"ds-note\"></textarea>",
      "css": ".ds-note{display:block;width:100%;min-height:80px;border:1px solid var(--line2,#CFC3AC);border-radius:12px;background:var(--panel,#fff);color:var(--ink,#221E18);font:16px Inter,system-ui,sans-serif;padding:10px 12px} :focus-visible{outline:3px solid var(--accent,#0E6B55);outline-offset:2px}"
    },
    {
