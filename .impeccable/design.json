      "css": ".ds-practice{border:2px solid var(--accent,#0E6B55);border-radius:18px;padding:20px 18px;background:var(--panel,#fff);color:var(--ink,#221E18);font:17px/1.7 Inter,system-ui,sans-serif;box-shadow:var(--shadow,0 1px 2px #281e0a0f)}.ds-practice strong{color:var(--accent,#0E6B55);font-size:15px} :focus-visible{outline:3px solid var(--accent,#0E6B55);outline-offset:2px}"
